flowchart TD
    D["① 討論<br/>主題・讀者・長度"] --> F["② 取得資料<br/>搜尋 → 抓取網頁"]
    F --> Q1{"抽取品質<br/>公式完整？"}
    Q1 -- "否：淘汰並記錄" --> F
    Q1 -- "是" --> I["③ Ingest<br/>寫 raw 筆記 → 更新概念頁<br/>數字登記到 claims.py"]
    I --> V{"④ 檢查 Wiki<br/>數學驗算＋結構 lint"}
    V -- "失敗：修概念頁" --> I
    V -- "還不到 5 份來源" --> F
    V -- "通過" --> O["⑤ 查詢 Wiki<br/>產生簡報大綱"]
    O --> G{"Wiki 夠用嗎？"}
    G -- "缺內容：回 Wiki 補" --> I
    G -- "夠用" --> S["⑥ 產生 HTML 簡報"]
    S --> C{"⑦ 檢查簡報<br/>可追溯・術語順序・版面"}
    C -- "術語順序錯" --> O
    C -- "數字對不上／版面問題" --> S
    C -- "通過" --> H["⑧ 人工看截圖"]
    H -- "發現自動檢查漏掉的問題<br/>→ 加強檢查程式" --> C
    H -- "沒問題" --> P["⑨ 發布 GitHub Pages"]

    classDef loop fill:#fbe4d6,stroke:#d2602a,color:#25211b;
    class Q1,V,G,C loop;
